---
// Ícones SVG desenhados à mão (sem dependência de biblioteca de ícones) —
// mantém o footprint de JS/CSS mínimo pedido pela stack. Cada símbolo é
// decorativo por padrão (aria-hidden); o texto acessível vem do elemento
// pai (link/botão) que o envolve.
interface Props {
  name:
    | "whatsapp"
    | "instagram"
    | "calendar"
    | "star"
    | "map-pin"
    | "menu"
    | "close"
    | "sparkle"
    | "play";
  class?: string;
  [attr: string]: unknown;
}

const { name, class: className = "size-5", ...rest } = Astro.props;
---

{
  name === "whatsapp" && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" {...rest}>
      <path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5L2 22l5.14-1.35a9.96 9.96 0 0 0 4.9 1.28h.01c5.52 0 10-4.48 10-10s-4.49-9.93-10.01-9.93Zm5.86 14.23c-.25.7-1.45 1.34-2 1.43-.51.08-1.16.12-1.87-.12-.43-.14-.98-.33-1.7-.64-2.98-1.29-4.93-4.3-5.08-4.5-.15-.2-1.22-1.62-1.22-3.1 0-1.47.77-2.19 1.05-2.5.27-.3.6-.38.8-.38h.57c.18 0 .43-.07.67.51.25.6.85 2.08.92 2.23.08.15.13.32.03.52-.1.2-.15.32-.3.5-.15.18-.32.4-.45.54-.15.15-.3.31-.13.6.17.3.77 1.27 1.65 2.06 1.14 1.02 2.1 1.33 2.4 1.48.3.15.47.13.65-.08.17-.2.73-.85.93-1.15.2-.3.4-.24.65-.14.27.09 1.66.79 1.95.93.28.15.47.22.54.34.07.13.07.72-.18 1.42Z" />
    </svg>
  )
}
{
  name === "instagram" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true" {...rest}>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "calendar" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true" {...rest}>
      <rect x="3.5" y="5" width="17" height="16" rx="2.5" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "star" && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" {...rest}>
      <path d="M12 2.6l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3.1 1.3-6.6-4.9-4.6 6.6-.8Z" />
    </svg>
  )
}
{
  name === "map-pin" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class={className} aria-hidden="true" {...rest}>
      <path d="M12 21s7-6.1 7-11.4A7 7 0 0 0 5 9.6C5 14.9 12 21 12 21Z" />
      <circle cx="12" cy="9.5" r="2.4" />
    </svg>
  )
}
{
  name === "menu" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class={className} aria-hidden="true" {...rest}>
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  )
}
{
  name === "close" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class={className} aria-hidden="true" {...rest}>
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  )
}
{
  name === "sparkle" && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" {...rest}>
      <path d="M12 2c.5 3.9 1.6 6.3 3.2 7.8 1.6 1.6 4 2.7 7.8 3.2-3.9.5-6.3 1.6-7.8 3.2-1.6 1.6-2.7 4-3.2 7.8-.5-3.9-1.6-6.3-3.2-7.8C7.4 14.6 5 13.5 1.2 13c3.9-.5 6.3-1.6 7.8-3.2C10.4 8.3 11.5 5.9 12 2Z" />
    </svg>
  )
}
{
  name === "play" && (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true" {...rest}>
      <path d="M8 5.5c0-.9 1-1.5 1.8-1l9 6.5c.7.5.7 1.5 0 2l-9 6.5c-.8.5-1.8-.1-1.8-1V5.5Z" />
    </svg>
  )
}
