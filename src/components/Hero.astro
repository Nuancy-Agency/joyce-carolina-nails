---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { CONTACT } from "../data/contact";
import heroImage from "../assets/midia/hero-manicure-verde-rubi.jpg";
---

<section id="topo" class="relative isolate overflow-hidden bg-brand-black">
  <Image
    src={heroImage}
    alt="Manicure em verde musgo com anel de rubi e brilhantes, foto real do trabalho da Joyce Carolina"
    class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_55%]"
    widths={[480, 828, 1200, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-brand-black via-brand-black/90 to-brand-black/45"
    aria-hidden="true"
  >
  </div>

  <div
    class="mx-auto flex min-h-[88svh] max-w-6xl flex-col justify-end px-5 pb-16 pt-32 sm:px-8 sm:pb-24"
  >
    <h1
      class="reveal max-w-2xl font-[family-name:var(--font-display)] text-4xl leading-[1.08] font-semibold text-brand-cream sm:text-6xl"
    >
      Detalhes que fazem <span class="text-brand-gold italic">toda a diferença</span>.
    </h1>

    <p
      class="reveal mt-6 max-w-xl text-pretty text-lg leading-relaxed text-brand-cream/85"
      style="transition-delay: 160ms;"
    >
      <Icon name="sparkle" class="mr-1 inline size-4 text-brand-gold" />
      Nail designer &amp; sobrancelhas em Lisboa — manicure russa, extensão de unhas, pedicure e
      sobrancelhas em um estúdio boutique perto do Marquês de Pombal, com técnica e delicadeza.
    </p>

    <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" style="transition-delay: 240ms;">
      <a
        href={CONTACT.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-gold px-6 py-3.5 text-sm font-semibold text-brand-black shadow-soft transition-colors hover:bg-brand-cream"
      >
        <Icon name="whatsapp" class="size-4" />
        Falar no WhatsApp
      </a>
      <a
        href={CONTACT.fresha}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-cream/40 px-6 py-3.5 text-sm font-semibold text-brand-cream transition-colors hover:bg-brand-cream/10"
      >
        <Icon name="calendar" class="size-4" />
        Agendar via Fresha
      </a>
    </div>

    <div
      class="reveal mt-9 inline-flex items-center gap-3 self-start rounded-2xl border border-brand-cream/15 bg-brand-black/40 px-5 py-3.5 backdrop-blur-sm"
      style="transition-delay: 320ms;"
    >
      <div class="flex text-brand-gold" role="img" aria-label={`Nota ${CONTACT.nota} de 5 estrelas`}>
        {Array.from({ length: 5 }).map(() => <Icon name="star" class="size-4" />)}
      </div>
      <p class="text-sm text-brand-cream/90">
        <span class="font-semibold text-brand-cream">{CONTACT.nota}</span> · {CONTACT.totalAvaliacoes}{" "}
        avaliações reais no Fresha
      </p>
    </div>
  </div>
</section>
