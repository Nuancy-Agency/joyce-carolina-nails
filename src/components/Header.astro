---
import Icon from "./Icon.astro";
import { CONTACT } from "../data/contact";

const navLinks = [
  { href: "#sobre", label: "Sobre" },
  { href: "#servicos", label: "Serviços" },
  { href: "#galeria", label: "Galeria" },
  { href: "#depoimentos", label: "Depoimentos" },
  { href: "#localizacao", label: "Localização" },
];
---

<header
  x-data="{ open: false }"
  x-on:keydown.escape.window="open = false"
  class="sticky top-0 z-50 border-b border-brand-black/5 bg-brand-cream/90 px-5 backdrop-blur sm:px-8"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 py-4">
    <a
      href="#topo"
      class="font-[family-name:var(--font-display)] text-xl font-semibold tracking-wide text-brand-black sm:text-2xl"
    >
      Joyce Carolina
      <span class="block text-xs font-normal tracking-[0.2em] text-brand-gold-ink uppercase">
        Nails &amp; Sobrancelhas
      </span>
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Navegação principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            class="text-sm font-medium text-brand-black/80 transition-colors hover:text-brand-gold-ink"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={CONTACT.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-brand-black/15 px-4 py-2 text-sm font-semibold text-brand-black transition-colors hover:border-brand-gold hover:text-brand-gold-ink"
      >
        <Icon name="whatsapp" class="size-4" />
        WhatsApp
      </a>
      <a
        href={CONTACT.fresha}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-brand-black px-4 py-2 text-sm font-semibold text-brand-cream transition-colors hover:bg-brand-gold hover:text-brand-black"
      >
        <Icon name="calendar" class="size-4" />
        Agendar
      </a>
    </div>

    <button
      type="button"
      x-on:click="open = !open"
      data-js-toggle
      class="inline-flex size-11 items-center justify-center rounded-full border border-brand-black/15 text-brand-black lg:hidden"
      x-bind:aria-expanded="open"
      aria-controls="menu-mobile"
      x-bind:aria-label="open ? 'Fechar menu de navegação' : 'Abrir menu de navegação'"
    >
      <Icon name="menu" class="size-5" x-show="!open" />
      <Icon name="close" class="size-5" x-show="open" x-cloak />
    </button>
  </div>

  <div
    id="menu-mobile"
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 -translate-y-1"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-on:click.outside="open = false"
    class="border-t border-brand-black/5 bg-brand-cream px-5 pb-6 lg:hidden"
  >
    <nav class="flex flex-col gap-1 pt-4" aria-label="Navegação mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            data-nav-link
            x-on:click="open = false"
            class="rounded-lg px-3 py-3 text-base font-medium text-brand-black hover:bg-brand-black/5"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-3 flex flex-col gap-3">
      <a
        href={CONTACT.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-brand-black/15 px-4 py-3 text-sm font-semibold text-brand-black"
      >
        <Icon name="whatsapp" class="size-4" />
        Falar no WhatsApp
      </a>
      <a
        href={CONTACT.fresha}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-black px-4 py-3 text-sm font-semibold text-brand-cream"
      >
        <Icon name="calendar" class="size-4" />
        Agendar horário
      </a>
    </div>
  </div>
</header>
