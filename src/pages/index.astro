---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Sobre from "../components/Sobre.astro";
import Servicos from "../components/Servicos.astro";
import Galeria from "../components/Galeria.astro";
import Depoimentos from "../components/Depoimentos.astro";
import Localizacao from "../components/Localizacao.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Footer from "../components/Footer.astro";

const title = "Joyce Carolina Nails — Nail Designer & Sobrancelhas em Lisboa";
const description =
  "Manicure russa, extensão de unhas, pedicure e sobrancelhas perto do Marquês de Pombal, Lisboa. Nota 5,0 com 82 avaliações reais. Agende pelo WhatsApp ou Fresha.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="conteudo">
    <Hero />
    <Sobre />
    <Servicos />
    <Galeria />
    <Depoimentos />
    <Localizacao />
    <CtaFinal />
  </main>
  <Footer />
</BaseLayout>
